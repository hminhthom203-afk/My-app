rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedSignedIn() && request.auth.token.email == 'hminhthom203@gmail.com';
    }

    function isValidCharacter(data) {
      return data.keys().hasAll([
        'name', 'avatar', 'hashtags', 'slogan', 'story',
        'link', 'linkLabel', 'likesCount', 'viewsCount',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'name', 'avatar', 'hashtags', 'slogan', 'story',
        'link', 'linkLabel', 'likesCount', 'viewsCount',
        'createdAt', 'updatedAt'
      ])
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 200000
      && data.hashtags is list && data.hashtags.size() >= 1 && data.hashtags.size() <= 10
      && data.hashtags[0] is string && data.hashtags[0].size() >= 1 && data.hashtags[0].size() <= 40
      && data.slogan is string && data.slogan.size() >= 1 && data.slogan.size() <= 200
      && data.story is string && data.story.size() >= 1 && data.story.size() <= 5000
      && data.link is string && data.link.size() <= 500
      && data.linkLabel is string && data.linkLabel.size() <= 80
      && data.likesCount is int && data.likesCount >= 0
      && data.viewsCount is int && data.viewsCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['userId', 'createdAt'])
      && data.keys().hasOnly(['userId', 'createdAt'])
      && data.userId is string && data.userId == request.auth.uid
      && data.createdAt is timestamp
      && data.createdAt == request.time;
    }

    function isValidComment(data, charId) {
      return data.keys().hasAll([
        'characterId', 'authorUid', 'authorName', 'content', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'characterId', 'authorUid', 'authorName', 'content', 'createdAt', 'updatedAt'
      ])
      && data.characterId is string && data.characterId == charId
      && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 500
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidTrack(data) {
      return data.keys().hasAll([
        'title', 'artist', 'mood', 'durationLabel', 'audioUrl', 'synthPreset', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'title', 'artist', 'mood', 'durationLabel', 'audioUrl', 'synthPreset', 'createdAt', 'updatedAt'
      ])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
      && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 100
      && data.mood is string && data.mood.size() >= 1 && data.mood.size() <= 100
      && data.durationLabel is string && data.durationLabel.size() >= 1 && data.durationLabel.size() <= 50
      && data.audioUrl is string && data.audioUrl.size() <= 500
      && data.synthPreset in ['rose_waltz', 'cotton_lullaby', 'velvet_nocturne', 'petal_breeze']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
        'type', 'characterId', 'characterName', 'actorUid', 'actorName',
        'message', 'recipientEmail', 'emailStatus', 'read', 'createdAt'
      ])
      && data.keys().hasOnly([
        'type', 'characterId', 'characterName', 'actorUid', 'actorName',
        'message', 'recipientEmail', 'emailStatus', 'read', 'createdAt'
      ])
      && data.type in ['like', 'comment']
      && isValidId(data.characterId)
      && data.characterName is string && data.characterName.size() >= 1 && data.characterName.size() <= 80
      && data.actorUid is string && data.actorUid == request.auth.uid
      && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
      && data.message is string && data.message.size() >= 1 && data.message.size() <= 600
      && data.recipientEmail is string && data.recipientEmail == 'hminhthom203@gmail.com'
      && data.emailStatus in ['sent', 'queued', 'not_configured']
      && data.read is bool
      && data.createdAt is timestamp;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'])
      && data.uid is string && data.uid == userId
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.role == 'viewer'
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Connection ping doc
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // Characters
    match /characters/{charId} {
      allow get: if isValidId(charId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(charId)
        && isValidCharacter(incoming())
        && incoming().likesCount == 0
        && incoming().viewsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(charId) && isValidCharacter(incoming()) && (
        (
          isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'avatar', 'hashtags', 'slogan', 'story', 'link', 'linkLabel', 'updatedAt'
          ])
          && incoming().createdAt == existing().createdAt
          && incoming().likesCount == existing().likesCount
          && incoming().viewsCount == existing().viewsCount
          && incoming().updatedAt == request.time
        )
        ||
        (
          isVerifiedSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
          && incoming().createdAt == existing().createdAt
          && incoming().viewsCount == existing().viewsCount
          && incoming().updatedAt == request.time
          && (
            (
              incoming().likesCount == existing().likesCount + 1
              && !exists(/databases/$(database)/documents/characters/$(charId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/characters/$(charId)/likes/$(request.auth.uid))
            )
            ||
            (
              incoming().likesCount == existing().likesCount - 1
              && incoming().likesCount >= 0
              && exists(/databases/$(database)/documents/characters/$(charId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/characters/$(charId)/likes/$(request.auth.uid))
            )
          )
        )
        ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount'])
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == existing().updatedAt
          && incoming().likesCount == existing().likesCount
          && incoming().viewsCount == existing().viewsCount + 1
        )
      );

      allow delete: if isAdmin() && isValidId(charId);

      // Subcollection: Likes (max 1 per user UID)
      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(charId) && isValidId(userId) && request.auth.uid == userId;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedSignedIn()
          && isValidId(charId)
          && isValidId(userId)
          && request.auth.uid == userId
          && isValidLike(incoming())
          && exists(/databases/$(database)/documents/characters/$(charId))
          && getAfter(/databases/$(database)/documents/characters/$(charId)).data.likesCount
             == get(/databases/$(database)/documents/characters/$(charId)).data.likesCount + 1;

        allow delete: if isVerifiedSignedIn()
          && isValidId(charId)
          && isValidId(userId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/characters/$(charId))
          && getAfter(/databases/$(database)/documents/characters/$(charId)).data.likesCount
             == get(/databases/$(database)/documents/characters/$(charId)).data.likesCount - 1;
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow get: if isValidId(charId) && isValidId(commentId);
        allow list: if isValidId(charId);

        allow create: if isVerifiedSignedIn()
          && isValidId(charId)
          && isValidId(commentId)
          && isValidComment(incoming(), charId)
          && incoming().authorUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/characters/$(charId));

        allow update: if isVerifiedSignedIn()
          && isValidId(charId)
          && isValidId(commentId)
          && isValidComment(incoming(), charId)
          && (isAdmin() || existing().authorUid == request.auth.uid)
          && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])
          && incoming().characterId == existing().characterId
          && incoming().authorUid == existing().authorUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;

        allow delete: if isVerifiedSignedIn()
          && isValidId(charId)
          && isValidId(commentId)
          && (isAdmin() || existing().authorUid == request.auth.uid);
      }
    }

    // Music tracks
    match /tracks/{trackId} {
      allow get: if isValidId(trackId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(trackId)
        && isValidTrack(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(trackId)
        && isValidTrack(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'artist', 'mood', 'durationLabel', 'audioUrl', 'synthPreset', 'updatedAt'
        ])
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(trackId);
    }

    // Admin Notifications
    match /notifications/{notifId} {
      allow get: if isAdmin() && isValidId(notifId);
      allow list: if isAdmin();

      allow create: if isVerifiedSignedIn()
        && isValidId(notifId)
        && isValidNotification(incoming())
        && incoming().read == false
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/characters/$(incoming().characterId));

      allow update: if isAdmin()
        && isValidId(notifId)
        && isValidNotification(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'emailStatus'])
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(notifId) && (
        isAdmin()
        || (
          isVerifiedSignedIn()
          && resource != null
          && existing().type == 'like'
          && existing().actorUid == request.auth.uid
        )
      );
    }

    // Users (PII protected)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isVerifiedSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }
  }
}
